            }
          }
        },
        {
          "name": "Asignar propietario a restaurante",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/admin/restaurants/1/assign",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
