              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_id\": 2\n}"
            }
          }
        },
        {
          "name": "Cambiar foto de portada",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/admin/restaurants/1/cover",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=800\"\n}"
            }
          }
        },
        {
          "name": "Estadísticas globales",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/stats",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ]
          }
        },
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/categories",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ]
          }
        }
      ]
    },
    {
      "name": "🔒 Pruebas de seguridad",
      "item": [
        {
          "name": "Sin token — debe dar 401",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/my/reservations",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Cliente accede a admin — debe dar 403",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/owners",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ]
          }
        },
        {
          "name": "Owner accede a admin — debe dar 403",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/admin/owners",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hack\",\n  \"email\": \"hack@test.com\"\n}"
            }
          }
        },
        {
          "name": "Reserva en el pasado — debe dar 422",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/reservations",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurant_id\": 1,\n  \"table_id\": 1,\n  \"start_time\": \"2020-01-01 20:00:00\",\n  \"guests\": 2\n}"
            }
          }
        },
        {
          "name": "SQL Injection en búsqueda — debe ser seguro",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/restaurants?search=' OR 1=1 --",
              "query": [{ "key": "search", "value": "' OR 1=1 --" }]
            },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    },
    {
      "name": "❤️ Health Check",
      "item": [
        {
          "name": "Estado de la API",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    }
  ]
}
