{
  "info": {
    "name": "ReservaYa API",
    "description": "Colección completa de endpoints para ReservaYa Backend Laravel 11",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "token",    "value": "" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Nuevo Usuario\",\n  \"email\": \"nuevo@ejemplo.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\",\n  \"phone\": \"+51 999 888 777\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json();", "if (r.token) pm.collectionVariables.set('token', r.token);"] } }],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"client@test.app\",\n  \"password\": \"password\"\n}" }
          }
        },
        {
          "name": "Mi Perfil (auth)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Logout (auth)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    },
    {
      "name": "🍽️ Restaurantes",
      "item": [
        {
          "name": "Listar todos",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/restaurants", "host": ["{{base_url}}"], "path": ["restaurants"] },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Filtrar por categoría",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/restaurants?category=italiana", "host": ["{{base_url}}"], "path": ["restaurants"], "query": [{ "key": "category", "value": "italiana" }] },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Filtrar por zona + fecha + hora",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/restaurants?zone=Miraflores&date=2025-02-20&time=20:00&guests=4", "host": ["{{base_url}}"], "path": ["restaurants"], "query": [{ "key": "zone", "value": "Miraflores" }, { "key": "date", "value": "2025-02-20" }, { "key": "time", "value": "20:00" }, { "key": "guests", "value": "4" }] },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Detalle de restaurante",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/restaurants/1?date=2025-02-20&time=20:00&guests=2", "host": ["{{base_url}}"], "path": ["restaurants", "1"], "query": [{ "key": "date", "value": "2025-02-20" }, { "key": "time", "value": "20:00" }, { "key": "guests", "value": "2" }] },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Mesas disponibles",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/restaurants/1/tables?date=2025-02-20&time=20:00&guests=2", "host": ["{{base_url}}"], "path": ["restaurants", "1", "tables"], "query": [{ "key": "date", "value": "2025-02-20" }, { "key": "time", "value": "20:00" }, { "key": "guests", "value": "2" }] },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    },
    {
      "name": "📂 Categorías",
      "item": [
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/categories",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    },
    {
      "name": "📅 Reservas",
      "item": [
        {
          "name": "Crear reserva (auth)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/reservations",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"restaurant_id\": 1,\n  \"table_id\": 1,\n  \"start_time\": \"2025-02-25 20:00:00\",\n  \"guests\": 2,\n  \"notes\": \"Mesa cerca a la ventana, por favor.\"\n}" }
          }
        },
        {
          "name": "Mis reservas (auth)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/my/reservations",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Ver reserva (auth)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reservations/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Cancelar reserva (auth)",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/reservations/1/cancel",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    },
    {
      "name": "❤️ Health Check",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        }
      ]
    }
  ]
}
