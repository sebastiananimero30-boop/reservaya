# ── Stage 1: Build frontend ────────────────────────────────

FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .

ARG VITE_API_URL
ARG VITE_GROQ_KEY
ARG VITE_STRIPE_PUBLIC_KEY
ARG VITE_GOOGLE_CLIENT_ID

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_GROQ_KEY=$VITE_GROQ_KEY
ENV VITE_STRIPE_PUBLIC_KEY=$VITE_STRIPE_PUBLIC_KEY
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

RUN npm run build



WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ── Stage 2: Build backend ─────────────────────────────────
FROM php:8.3-fpm-alpine AS backend-builder
RUN apk add --no-cache postgresql-dev libzip-dev unzip curl
RUN docker-php-ext-install pdo pdo_pgsql zip opcache
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html
COPY backend/ .
RUN composer install --no-dev --optimize-autoloader --no-interaction

# ── Stage 3: Imagen final ──────────────────────────────────
FROM php:8.3-fpm-alpine
RUN apk add --no-cache postgresql-dev libzip-dev nginx bash
RUN docker-php-ext-install pdo pdo_pgsql zip opcache

# Backend
WORKDIR /var/www/html
COPY --from=backend-builder /var/www/html .
RUN chmod -R 775 storage bootstrap/cache

# Frontend buildeado → donde Nginx lo sirve
COPY --from=frontend-builder /app/dist /var/www/html/public-frontend

# Nginx config
COPY docker/nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080

CMD ["/bin/bash", "-c", "\
  php artisan config:cache && \
  php artisan migrate --force && \
  php artisan db:seed --force && \
  php-fpm -D && \
  nginx -g 'daemon off;'"]